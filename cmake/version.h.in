#ifndef KICKCAM_VERSION_H
#define KICKCAM_VERSION_H

// Generated at build time from cmake/version.h.in by cmake/version.cmake.
// Do not edit. Values are derived from `git describe`; a build without git
// (e.g. a source tarball) falls back to 0.0.0 / "unknown".

#define KICKCAM_VERSION_MAJOR @KICKCAM_VERSION_MAJOR@
#define KICKCAM_VERSION_MINOR @KICKCAM_VERSION_MINOR@
#define KICKCAM_VERSION_PATCH @KICKCAM_VERSION_PATCH@

#define KICKCAM_VERSION_STRING "@KICKCAM_VERSION_STRING@"

// Precise build identity (full `git describe`, e.g. "v0.5.0-3-gabc1234-dirty").
#define KICKCAM_GIT_DESCRIBE    "@KICKCAM_GIT_DESCRIBE@"
#define KICKCAM_GIT_BRANCH      "@KICKCAM_GIT_BRANCH@"
#define KICKCAM_GIT_TAG         "@KICKCAM_GIT_TAG@"
#define KICKCAM_GIT_COMMIT_HASH "@KICKCAM_GIT_COMMIT_HASH@"
#define KICKCAM_GIT_DIRTY       @KICKCAM_GIT_DIRTY@

#endif
